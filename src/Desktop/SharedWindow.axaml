<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmuleModern.Desktop.SharedWindow">
  <Grid Margin="28,24" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Compartidos" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Incoming se comparte solo. Las carpetas extra las eliges tú." Classes="muted" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
        <TextBlock x:Name="CountBadge" Text="0 archivos" Classes="accent" FontSize="12"/>
      </Border>
    </Grid>
    <Border Grid.Row="1" Classes="panel" Margin="0,20,0,14" Padding="16">
      <Grid ColumnDefinitions="*,12,Auto,8,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="CARPETAS EXTRA" Classes="section"/>
        <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="8">
          <TextBlock x:Name="FoldersText" Text="Incoming se comparte automáticamente." FontSize="12" TextWrapping="Wrap" Classes="muted"/>
          <ComboBox x:Name="ExtraFoldersInput" PlaceholderText="Selecciona una carpeta extra" HorizontalAlignment="Stretch" SelectionChanged="SelectionChanged"/>
        </StackPanel>
        <Button x:Name="AddFolderButton" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Content="Añadir…" Click="AddFolder" IsEnabled="False"/>
        <Button x:Name="RemoveFolderButton" Grid.Column="4" Grid.RowSpan="2" VerticalAlignment="Center" Content="Quitar" Click="RemoveFolder" IsEnabled="False"/>
      </Grid>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBox x:Name="FilterInput" PlaceholderText="Filtrar por nombre…" Width="280" HorizontalAlignment="Left" TextChanged="FilterChanged"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button x:Name="CopyLinkButton" Content="Copiar enlace" Click="CopyLink" IsEnabled="False"/>
        <Button x:Name="OpenFolderButton" Content="Abrir carpeta" Click="OpenFolder" IsEnabled="False"/>
        <Button x:Name="ReloadButton" Content="↻" Click="ReloadClicked" IsEnabled="False"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="3" Classes="card" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="SharedGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  SelectionChanged="SelectionChanged" HeadersVisibility="Column" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ARCHIVO" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="TAMAÑO" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"/>
            <DataGridTextColumn Header="CARPETA" Binding="{Binding FolderText}" Width="180"/>
            <DataGridTextColumn Header="PETICIONES" Binding="{Binding Requests}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyShared" Text="No hay archivos compartidos visibles." Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12">
      <Button Content="Abrir Incoming" Click="OpenIncoming"/>
    </StackPanel>
    <Border Grid.Row="5" Classes="panel" Padding="14,10">
      <TextBlock x:Name="StatusMessage" Text="Cargando compartidos…" TextWrapping="Wrap" Classes="muted" FontSize="12"/>
    </Border>
  </Grid>
</UserControl>
