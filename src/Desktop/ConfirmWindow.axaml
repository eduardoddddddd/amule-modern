<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmuleModern.Desktop.ConfirmWindow"
        Width="460" Height="220" MinWidth="420" MinHeight="190" CanResize="False"
        Background="{DynamicResource App.Bg}" WindowStartupLocation="CenterOwner">
  <Border Classes="card" Margin="16" Padding="20">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="BodyText" Grid.Row="1" Margin="0,12,0,18" TextWrapping="Wrap" Classes="muted" FontSize="13"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Volver" Click="CancelClicked"/>
        <Button x:Name="AcceptButton" Classes="danger" Content="Cancelar descargas" Click="AcceptClicked"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
