<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AmuleModern.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="TextBlock"><Setter Property="FontFamily" Value="Inter" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="15,10" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#A6B2C6" /><Setter Property="Margin" Value="0,3" /></Style>
    <Style Selector="Button.selected"><Setter Property="Background" Value="#20354A" /><Setter Property="Foreground" Value="#8AE0D0" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#80DBC6" /><Setter Property="Foreground" Value="#10251F" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7" /><Setter Property="MinHeight" Value="39" /></Style>
    <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="#172332" /><Setter Property="Foreground" Value="#A6B2C6" /><Setter Property="FontSize" Value="12" /></Style>
  </Application.Styles>
</Application>
