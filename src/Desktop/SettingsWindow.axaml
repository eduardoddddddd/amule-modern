<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmuleModern.Desktop.SettingsWindow">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,24" RowDefinitions="Auto,*,Auto,Auto" MinWidth="480">
      <StackPanel Spacing="4">
        <TextBlock Text="Ajustes" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Carpetas, límites y red. El tema de la interfaz está en la barra lateral." Classes="muted" FontSize="13" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,22,0,0" Spacing="18">
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="DESCARGAS COMPLETADAS (INCOMING)" Classes="section"/>
            <Grid ColumnDefinitions="*,10,Auto">
              <TextBox x:Name="IncomingInput"/>
              <Button Grid.Column="2" Content="Elegir…" Click="BrowseIncoming"/>
            </Grid>
            <TextBlock Text="ARCHIVOS TEMPORALES (TMP)" Classes="section" Margin="0,8,0,0"/>
            <Grid ColumnDefinitions="*,10,Auto">
              <TextBox x:Name="TempInput"/>
              <Button Grid.Column="2" Content="Elegir…" Click="BrowseTemp"/>
            </Grid>
            <TextBlock Text="Al aplicar carpetas se reinicia el motor. No puedes cambiar tmp si hay descargas pendientes." Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
          </StackPanel>
        </Border>
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="LÍMITES DE ANCHO DE BANDA (KIB/S)" Classes="section"/>
            <TextBlock Text="0 es ilimitado. Si la subida es muy baja, aMule puede recortar la bajada." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,14,*">
              <StackPanel Spacing="6">
                <TextBlock Text="Bajada" Classes="muted" FontSize="12"/>
                <TextBox x:Name="DownloadLimitInput" PlaceholderText="0 = ilimitado" MaxLength="6"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="6">
                <TextBlock Text="Subida" Classes="muted" FontSize="12"/>
                <TextBox x:Name="UploadLimitInput" PlaceholderText="0 = ilimitado" MaxLength="6"/>
              </StackPanel>
            </Grid>
            <Button x:Name="ApplyLimitsButton" Content="Aplicar límites" Click="ApplyLimitsClicked" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="RED KAD" Classes="section"/>
            <TextBlock x:Name="KadStatus" Text="Kad está desactivado. No se abre el cortafuegos." FontSize="12" Classes="muted" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="KadEnableButton" Content="Activar Kad" Click="EnableKad"/>
              <Button x:Name="KadDisableButton" Content="Desactivar Kad" Click="DisableKad"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16">
        <Button Content="Abrir Incoming" Click="OpenIncoming"/>
        <Button x:Name="ApplyButton" Classes="primary" Content="Aplicar y reiniciar motor" Click="ApplyClicked"/>
      </StackPanel>
      <Border Grid.Row="3" Classes="panel" Padding="14,10">
        <TextBlock x:Name="StatusMessage" Text="Revisa las rutas antes de aplicar." TextWrapping="Wrap" Classes="muted" FontSize="12"/>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
