<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AmuleModern.Desktop.MainWindow"
        Icon="avares://AmuleModern/Assets/amule-modern.ico"
        Title="aMule Modern" Width="1280" Height="820" MinWidth="1040" MinHeight="640"
        Background="{DynamicResource App.Bg}" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="232,*" RowDefinitions="*,36">
    <!-- Sidebar -->
    <Border Grid.RowSpan="2" Background="{DynamicResource App.Sidebar}"
            BorderBrush="{DynamicResource App.SidebarBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,24,14,16">
        <StackPanel Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border CornerRadius="10" Width="36" Height="36" ClipToBounds="True">
              <Image Source="avares://AmuleModern/Assets/amule-modern.png" Stretch="UniformToFill"
                     RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="aMule" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="MODERN" Classes="dim" FontSize="9" LetterSpacing="2.4"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="Biblioteca y transferencias" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,28,0,16" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="PRINCIPAL" Classes="section" Margin="12,0,0,8"/>
            <Button x:Name="NavDownloads" Classes="nav selected" Content="Descargas" Click="NavDownloadsClicked"/>
            <Button x:Name="NavSearch" Classes="nav" Content="Buscar" Click="NavSearchClicked" IsEnabled="False"/>
            <Button x:Name="NavServers" Classes="nav" Content="Servidores" Click="NavServersClicked" IsEnabled="False"/>
            <Button x:Name="NavShared" Classes="nav" Content="Compartidos" Click="NavSharedClicked" IsEnabled="False"/>
            <Border Height="1" Background="{DynamicResource App.Border}" Margin="10,18"/>
            <TextBlock Text="SISTEMA" Classes="section" Margin="12,0,0,8"/>
            <Button x:Name="NavSettings" Classes="nav" Content="Ajustes" Click="NavSettingsClicked" IsEnabled="False"/>
            <Button Classes="nav" Content="Abrir Incoming" Click="OpenDownloads"/>
            <Button x:Name="QuitButton" Classes="nav" Content="Salir y detener" Click="QuitClicked"
                    ToolTip.Tip="Cierra la aplicación y detiene el motor"/>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="10">
          <Border Classes="panel" Padding="12">
            <StackPanel Spacing="6">
              <TextBlock Text="APARIENCIA" Classes="section"/>
              <ComboBox x:Name="ThemeInput" HorizontalAlignment="Stretch" SelectionChanged="ThemeChanged">
                <ComboBoxItem Content="Oscuro" Tag="Dark"/>
                <ComboBoxItem Content="Claro" Tag="Light"/>
                <ComboBoxItem Content="Sistema" Tag="System"/>
              </ComboBox>
              <TextBlock Text="FILAS" Classes="section" Margin="0,8,0,0"/>
              <ComboBox x:Name="DensityInput" HorizontalAlignment="Stretch" SelectionChanged="DensityChanged"
                        ToolTip.Tip="La compacta usa filas de 36 px. Se recuerda en este equipo.">
                <ComboBoxItem Content="Cómoda" Tag="Comfortable"/>
                <ComboBoxItem Content="Compacta" Tag="Compact"/>
              </ComboBox>
            </StackPanel>
          </Border>
          <Border Classes="panel" Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="SEGUNDO PLANO" Classes="accent" FontSize="9" LetterSpacing="1.2" FontWeight="SemiBold"/>
              <TextBlock Text="La X oculta a la bandeja. Salir detiene el motor." Classes="muted" FontSize="11" TextWrapping="Wrap" LineHeight="16"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Content host -->
    <Panel Grid.Column="1">
      <Grid x:Name="DownloadsPanel" Margin="28,24,28,12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Descargas" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Cola del motor, con control directo sobre cada transferencia." Classes="muted" FontSize="13"/>
          </StackPanel>
          <Border Grid.Column="1" Classes="badge" VerticalAlignment="Top">
            <TextBlock x:Name="EngineBadge" Text="●  Iniciando motor" Classes="accent" FontSize="11"/>
          </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,12,*,12,*" Margin="0,22,0,20">
          <Border Classes="panel" Padding="16,14">
            <StackPanel Spacing="6">
              <TextBlock Text="EN COLA" Classes="section"/>
              <TextBlock x:Name="QueueCount" Text="0" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="panel" Padding="16,14">
            <StackPanel Spacing="6">
              <TextBlock Text="DESCARGA" Classes="section"/>
              <TextBlock x:Name="DownloadSpeed" Text="—" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Classes="panel" Padding="16,14">
            <StackPanel Spacing="6">
              <TextBlock Text="SUBIDA" Classes="section"/>
              <TextBlock x:Name="UploadSpeed" Text="—" FontSize="22" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,12,Auto" Margin="0,0,0,14">
          <TextBox x:Name="LinkInput" PlaceholderText="Pega un enlace ed2k:// de archivo" KeyDown="LinkKeyDown"/>
          <Button x:Name="AddButton" Grid.Column="2" Classes="primary" Content="Añadir enlace" Click="AddLink" IsEnabled="False"/>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <TextBox x:Name="FilterInput" PlaceholderText="Filtrar por nombre…" Width="280" HorizontalAlignment="Left" TextChanged="FilterChanged"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="PauseButton" Content="Pausar" Click="PauseSelected" IsEnabled="False"/>
            <Button x:Name="ResumeButton" Content="Reanudar" Click="ResumeSelected" IsEnabled="False"/>
            <Button x:Name="CancelButton" Classes="danger" Content="Cancelar" Click="CancelSelected"
                    ToolTip.Tip="Cancela descargas incompletas y borra sus temporales" IsEnabled="False"/>
            <Button x:Name="ClearButton" Content="Quitar de la lista" Click="ClearCompletedSelected"
                    ToolTip.Tip="Quita completados de la cola. Conserva el archivo en Incoming." IsEnabled="False"/>
            <Button x:Name="ColumnsButton" Content="Columnas" ToolTip.Tip="Elige qué columnas se ven. El ancho y el orden también se recuerdan."/>
            <Button x:Name="RefreshButton" Content="↻" Click="RefreshClicked" ToolTip.Tip="Actualizar" IsEnabled="False"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="4" RowDefinitions="*,Auto">
        <Border Classes="card" ClipToBounds="True">
          <Grid>
            <DataGrid x:Name="DownloadsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                      SelectionChanged="SelectionChanged" HeadersVisibility="Column"
                      CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ARCHIVO" Binding="{Binding Name}" Width="*" MinWidth="200"/>
                <DataGridTextColumn Header="TAMAÑO" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"/>
                <DataGridTemplateColumn Header="PROGRESO" Width="140" SortMemberPath="Progress">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel VerticalAlignment="Center" Margin="10,0" Spacing="4">
                        <TextBlock Text="{Binding ProgressText}" FontSize="11" Classes="muted"/>
                        <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="4"
                                     Foreground="{DynamicResource App.Accent}" Background="{DynamicResource App.ProgressTrack}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding StateText}" Width="120"/>
                <DataGridTextColumn Header="VELOCIDAD" Binding="{Binding SpeedText}" SortMemberPath="Speed" Width="110"/>
                <DataGridTextColumn Header="FUENTES" Binding="{Binding Sources}" Width="90"/>
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsHitTestVisible="False">
              <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource App.AccentSoft}" HorizontalAlignment="Center">
                <TextBlock Text="↓" FontSize="28" Classes="accent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="EmptyTitle" Text="Tu próxima descarga empieza aquí" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center"/>
              <TextBlock Text="Añade un enlace o busca archivos.&#10;Conecta un servidor desde Servidores." Classes="muted" FontSize="12" LineHeight="20" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Classes="panel" Margin="0,10,0,0" Padding="14,12">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="DETALLE" Classes="section"/>
              <TextBlock x:Name="DetailHint" Text="Selecciona una descarga para ver hash, ruta y fuentes." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
              <TextBlock x:Name="DetailHash" Classes="muted" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
              <TextBlock x:Name="DetailPath" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
              <TextBlock x:Name="DetailMeta" Classes="muted" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
              <TextBlock x:Name="DetailLink" Classes="muted" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
              <TextBlock x:Name="DetailFacts" Classes="muted" FontSize="12" IsVisible="False" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button x:Name="CopyHashButton" Content="Copiar hash" Click="CopyHash" IsEnabled="False"/>
              <Button x:Name="CopyLinkButton" Content="Copiar enlace" Click="CopyLink" IsEnabled="False"/>
              <Button x:Name="OpenFolderButton" Content="Abrir carpeta" Click="OpenDetailFolder" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </Border>
        </Grid>

        <Border Grid.Row="5" Classes="panel" Margin="0,12,0,0" Padding="14,10">
          <TextBlock x:Name="Message" Text="Preparando el perfil…" TextWrapping="Wrap" Classes="muted" FontSize="12"/>
        </Border>
      </Grid>

      <ContentControl x:Name="PageHost" IsVisible="False" Margin="0"/>
    </Panel>

    <!-- Status bar -->
    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource App.StatusBar}"
            BorderBrush="{DynamicResource App.SidebarBorder}" BorderThickness="0,1,0,0" Padding="20,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock x:Name="ConnectionStatus" Text="Motor local · esperando autenticación" Classes="muted" FontSize="11"/>
        <TextBlock Grid.Column="1" Text="aMule Modern  ·  Avalonia" Classes="dim" FontSize="10"/>
      </Grid>
    </Border>
  </Grid>
</Window>
