<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmuleModern.Desktop.LogWindow">
  <Grid Margin="28,24" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Text="Actividad" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock Text="Registro del motor aMule. Se puede copiar entero." Classes="muted" FontSize="13"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
        <Button x:Name="CopyButton" Content="Copiar" Click="CopyLog" IsEnabled="False"/>
        <Button x:Name="RefreshButton" Content="↻  Actualizar" Click="RefreshClicked" IsEnabled="False"/>
      </StackPanel>
    </Grid>
    <TextBlock x:Name="LogStatus" Grid.Row="1" Margin="0,16,0,10" Classes="muted" FontSize="12" Text="Cargando el registro…"/>
    <Border Grid.Row="2" Classes="card" Padding="12">
      <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Consolas,Cascadia Mono,monospace" FontSize="12"/>
    </Border>
  </Grid>
</UserControl>
