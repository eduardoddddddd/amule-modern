<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AmuleModern.Desktop.SearchWindow">
  <Grid Margin="28,24" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
    <StackPanel Spacing="4">
      <TextBlock Text="Buscar" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock x:Name="NetworkLabel" Text="Consultando conexión…" Classes="muted" FontSize="13"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,12,180,12,Auto,8,Auto" Margin="0,20,0,10">
      <TextBox x:Name="QueryInput" PlaceholderText="Nombre del archivo…" MaxLength="512" KeyDown="QueryKeyDown"/>
      <ComboBox x:Name="ScopeInput" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ScopeChanged">
        <ComboBoxItem Content="Servidor actual"/>
        <ComboBoxItem Content="Global eD2k"/>
        <ComboBoxItem Content="Kad"/>
      </ComboBox>
      <Button x:Name="SearchButton" Grid.Column="4" Content="Buscar" Classes="primary" Click="SearchClicked" IsEnabled="False"/>
      <Button x:Name="StopButton" Grid.Column="6" Content="Detener" Click="StopClicked" IsEnabled="False"/>
    </Grid>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
      <StackPanel x:Name="TabBar" Orientation="Horizontal" Spacing="6"/>
    </ScrollViewer>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock x:Name="ResultCount" Text="RESULTADOS" Classes="section" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <TextBox x:Name="FilterInput" PlaceholderText="Filtrar esta pestaña…" Width="240" TextChanged="FilterChanged"/>
        <Button x:Name="ColumnsButton" Content="Columnas" ToolTip.Tip="Elige qué columnas se ven. El ancho y el orden también se recuerdan."/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="4" Classes="card" ClipToBounds="True">
      <Grid>
        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  SelectionChanged="SelectionChanged" DoubleTapped="ResultDoubleTapped" HeadersVisibility="Column"
                  CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ARCHIVO" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="TAMAÑO" Binding="{Binding SizeText}" SortMemberPath="Size" Width="110"/>
            <DataGridTextColumn Header="FUENTES" Binding="{Binding Sources}" Width="90"/>
            <DataGridTextColumn Header="COMPLETAS" Binding="{Binding CompleteSources}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyResults" Text="Escribe un nombre y pulsa Buscar. Cada búsqueda se guarda en una pestaña." Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextAlignment="Center"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12">
      <Button Content="Ir a descargas" Click="ShowDownloads"/>
      <Button x:Name="DownloadButton" Content="Descargar seleccionados" Classes="primary" Click="DownloadClicked" IsEnabled="False"/>
    </StackPanel>
    <Border Grid.Row="6" Classes="panel" Padding="14,10">
      <TextBlock x:Name="StatusMessage" Text="Cada búsqueda abre una pestaña. Solo una está activa en el motor; las anteriores quedan como instantánea." TextWrapping="Wrap" Classes="muted" FontSize="12"/>
    </Border>
  </Grid>
</UserControl>
