<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AmuleModern.Desktop.SearchWindow"
 Title="Buscar · aMule Modern" Width="1040" Height="690" MinWidth="860" MinHeight="580" Background="#111B29" Foreground="#E6ECF5" FontFamily="Inter" WindowStartupLocation="CenterOwner">
 <Grid Margin="28" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
  <StackPanel Spacing="7"><TextBlock Text="Buscar archivos" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="NetworkLabel" Text="Consultando conexión…" Foreground="#8C9DB5" FontSize="13"/></StackPanel>
  <Grid Grid.Row="1" ColumnDefinitions="*,12,190,12,Auto,8,Auto" Margin="0,24,0,16">
   <TextBox x:Name="QueryInput" PlaceholderText="Nombre del archivo…" MaxLength="512" KeyDown="QueryKeyDown"/>
   <ComboBox x:Name="ScopeInput" Grid.Column="2" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="Servidor actual"/><ComboBoxItem Content="Global eD2k"/></ComboBox>
   <Button x:Name="SearchButton" Grid.Column="4" Content="Buscar" Classes="primary" Click="SearchClicked" IsEnabled="False"/>
   <Button x:Name="StopButton" Grid.Column="6" Content="Detener" Click="StopClicked" IsEnabled="False"/>
  </Grid>
  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12"><TextBlock x:Name="ResultCount" Text="RESULTADOS" VerticalAlignment="Center" Foreground="#8C9DB5" FontSize="11"/><TextBox x:Name="FilterInput" Grid.Column="1" Width="250" PlaceholderText="Filtrar resultados…" TextChanged="FilterChanged"/></Grid>
  <Border Grid.Row="3" BorderBrush="#263448" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><Grid>
   <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="SelectionChanged" DoubleTapped="ResultDoubleTapped" RowHeight="44" Background="#131F2D" BorderThickness="0" GridLinesVisibility="None" CanUserSortColumns="True">
    <DataGrid.Columns>
     <DataGridTextColumn Header="ARCHIVO" Binding="{Binding Name}" Width="*" MinWidth="230"/>
     <DataGridTextColumn Header="TAMAÑO" Binding="{Binding SizeText}" SortMemberPath="Size" Width="115"/>
     <DataGridTextColumn Header="FUENTES" Binding="{Binding Sources}" Width="105"/>
     <DataGridTextColumn Header="COMPLETAS" Binding="{Binding CompleteSources}" Width="115"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock x:Name="EmptyResults" Text="Escribe un nombre y pulsa Buscar." Foreground="#8C9DB5" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
  </Grid></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16"><Button Content="Ver descargas" Click="ShowDownloads"/><Button x:Name="DownloadButton" Content="Descargar seleccionados" Classes="primary" Click="DownloadClicked" IsEnabled="False"/></StackPanel>
  <Border Grid.Row="5" Background="#192637" CornerRadius="8" Padding="13"><TextBlock x:Name="StatusMessage" Text="Los resultados se actualizarán mientras buscas." TextWrapping="Wrap" Foreground="#ABBAD0" FontSize="12"/></Border>
 </Grid>
</Window>
